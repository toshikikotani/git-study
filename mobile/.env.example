# iPhone 版の設定(どれも公開してよい値。Expo のプロジェクトの Environment variables にも同じ名前で入れる)
# Supabase の Project URL と anon(publishable)キー(Web 版の NEXT_PUBLIC_SUPABASE_* と同じ値)
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Web 版(Vercel)の URL。iPhone 版は ここの /api/mobile/* を呼ぶ
EXPO_PUBLIC_API_BASE_URL=https://example.vercel.app
