# 個人資産形成システム — 環境変数のひな形
#
# このファイルをコピーして .env.local を作る。
#   cp .env.example .env.local
#
# .env / .env.local はリポジトリに含めない(NFR-04)。
# 本番は Vercel の Environment Variables と GitHub Secrets に設定する。

# ── Supabase ────────────────────────────────────────────────
# Supabase ダッシュボード → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RLS を越える。サーバー側専用。ブラウザに渡るコードから参照しないこと。
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude API(明細分類・朝配信の生成)────────────────────
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-

# ── Discord(通知・朝配信の送信先)──────────────────────────
# サーバー設定 → 連携サービス → ウェブフック で発行
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/

# ── 定期ジョブ ──────────────────────────────────────────────
# /api/cron/* の認証に使う。32文字以上のランダム文字列。
#   openssl rand -hex 32
CRON_SECRET=

# GitHub Actions からアプリを叩くときの宛先(GitHub Secrets 側にのみ設定)
# APP_BASE_URL=https://example.vercel.app

# ── Gmail 自動取得(任意)──────────────────────────────────
# カード利用通知メールを自動で取り込む。未設定でもアプリは動く。
#
# 通常の Gmail パスワードでは接続できない(Google は 2025年5月に
# 通常パスワードでの third-party アクセスを停止した)。
# アプリパスワード(16文字)を発行して使う:
#
#   1. Google アカウントで2段階認証を有効にする
#   2. https://myaccount.google.com/apppasswords で発行
#   3. 表示された16文字を下に貼る(空白は入れても構わない)
#
# 発行したパスワードはメールの読み取りにのみ使われ、
# いつでも同じ画面から失効させられる。
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=
