# 個人資産形成システム — 環境変数のひな形
#
# このファイルをコピーして .env.local を作る。
#   cp .env.example .env.local
#
# .env / .env.local はリポジトリに含めない(NFR-04)。
# 本番は Vercel の Environment Variables と GitHub Secrets に設定する。

# ── Supabase ────────────────────────────────────────────────
# Supabase ダッシュボード → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RLS を越える。サーバー側専用。ブラウザに渡るコードから参照しないこと。
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude API(明細分類・朝配信の生成)────────────────────
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-

# ── Discord(通知・朝配信の送信先)──────────────────────────
# サーバー設定 → 連携サービス → ウェブフック で発行
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/

# ── LINE(通知・朝配信の送信先。Discord と併用可)──────────────
# Discord と両方設定すれば両方に届く。片方だけでもよい。
#
#   1. https://developers.line.biz/console/ で Provider → Messaging API
#      チャネルを作成(LINE Official Account が1つ作られる)
#   2. チャネル基本設定の下部「チャネルアクセストークン(長期)」を発行
#   3. 作成した公式アカウントを自分の LINE アプリで友だち追加し、
#      何かメッセージを送る(userId を取得するため)
#   4. チャネル基本設定の Webhook 送信を有効化し、届いた Webhook イベントの
#      events[0].source.userId を控える('U' + 32桁の16進数、33文字)
#      (このアプリは Webhook 受信エンドポイントを持たないため、
#      LINE Developers コンソールの Webhook テスト送信機能や、
#      一時的な受信用サービスで拾う)
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_USER_ID=

# ── 定期ジョブ ──────────────────────────────────────────────
# /api/cron/* の認証に使う。32文字以上のランダム文字列。
#   openssl rand -hex 32
CRON_SECRET=

# GitHub Actions からアプリを叩くときの宛先(GitHub Secrets 側にのみ設定)
# APP_BASE_URL=https://example.vercel.app

# ── Gmail 自動取得(任意)──────────────────────────────────
# カード利用通知メールを自動で取り込む。未設定でもアプリは動く。
#
# 通常の Gmail パスワードでは接続できない(Google は 2025年5月に
# 通常パスワードでの third-party アクセスを停止した)。
# アプリパスワード(16文字)を発行して使う:
#
#   1. Google アカウントで2段階認証を有効にする
#   2. https://myaccount.google.com/apppasswords で発行
#   3. 表示された16文字を下に貼る(空白は入れても構わない)
#
# 発行したパスワードはメールの読み取りにのみ使われ、
# いつでも同じ画面から失効させられる。
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=

# 取り込み先の口座(/accounts で作った accounts.id)。GMAIL_ADDRESS/
# GMAIL_APP_PASSWORD と合わせてこれも設定して初めて自動取り込みが動く。
# GMAIL_IMPORT_ACCOUNT_ID=

# ── Google連携(任意。カレンダー同期・スプレッドシート自動バックアップ)──
# 未設定でもアプリは動く(/api/cron/sync-google がスキップするだけ)。
#
#   1. https://console.cloud.google.com/ でプロジェクトを作成
#   2. 「APIとサービス」→「ライブラリ」で Google Calendar API と
#      Google Sheets API を有効化
#   3. 「OAuth 同意画面」を作成(User Type: 外部、公開ステータス: テスト
#      でよい。本人のGoogleアカウントを「テストユーザー」に追加)
#   4. 「認証情報」→「OAuth クライアント ID」を作成
#      (アプリケーションの種類: ウェブアプリケーション、
#      承認済みのリダイレクトURI: {アプリのURL}/api/auth/google/callback)
#   5. 発行された クライアントID・クライアントシークレットを下に設定し、
#      アプリを起動して /settings/google の「Google と連携する」から同意する
#      (最後に refresh_token が画面に一度だけ表示されるので、それも設定する)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
